# ========================================
# WebSerialTool 开发环境配置
# ========================================
# 此文件用于开发环境（NODE_ENV=development）

# ----------------------------------------
# 环境标识
# ----------------------------------------
NODE_ENV=development

# ----------------------------------------
# 服务器配置
# ----------------------------------------
PORT=3001
HOST=0.0.0.0

# ----------------------------------------
# 数据库配置（开发环境）
# ----------------------------------------
# DATABASE_URL 必须直接配置，不再支持自动构建
# 开发环境使用 localhost（本地数据库）
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=web_serial
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_serial

# ----------------------------------------
# Redis 配置（开发环境）
# ----------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------
# JWT 配置
# ----------------------------------------
JWT_SECRET=dev-secret-key-for-testing-only-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------------------
# CORS 配置（开发环境）
# ----------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ----------------------------------------
# 限流配置
# ----------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_WIKI_MAX_REQUESTS=200

# ----------------------------------------
# 邮件服务配置
# ----------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=webserialtool@gmail.com
EMAIL_PASS=yypudrnmfqulxxlw
EMAIL_FROM=WebSerialTool <webserialtool@gmail.com>
EMAIL_SECURE=false

# ----------------------------------------
# 安全配置
# ----------------------------------------
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=10

# ----------------------------------------
# 日志配置（开发环境）
# ----------------------------------------
LOG_LEVEL=debug
LOG_PATH=./logs
