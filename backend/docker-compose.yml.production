services:
  # PostgreSQL 数据库
  postgres:
    image: postgres:14-alpine
    container_name: web-serial-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USER:-webserial}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-postgres}
      POSTGRES_DB: ${DB_NAME:-web_serial}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-webserial} -d ${DB_NAME:-web_serial}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis 缓存
  redis:
    image: redis:7-alpine
    container_name: web-serial-redis
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    # 生产环境：可以设置资源限制
    # deploy:
    #   resources:
    #     limits:
    #       memory: 512M
    #     reservations:
    #       memory: 256M

  # 后端服务（生产环境：在 Docker 中运行）
  backend:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: web-serial-backend
    restart: unless-stopped
    ports:
      - "3001:3001"
    env_file:
      - .env
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - ./logs:/app/logs
    entrypoint: ["/bin/sh", "/app/docker-entrypoint.sh"]
    # 生产环境：可以设置资源限制
    # deploy:
    #   resources:
    #     limits:
    #       memory: 1G
    #       cpus: '1.0'
    #     reservations:
    #       memory: 512M
    #       cpus: '0.5'

volumes:
  postgres_data:
  redis_data:

